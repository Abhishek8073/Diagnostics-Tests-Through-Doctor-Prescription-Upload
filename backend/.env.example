# Copy this file to .env and fill in real values.
# .env itself is git-ignored — never commit real secrets.

DB_URL=jdbc:postgresql://localhost:5432/DiagonosticDatabase
DB_USERNAME=postgres
DB_PASSWORD=

# Generate a real random secret, e.g.: openssl rand -base64 48
JWT_SECRET=

# Optional overrides (sane defaults already exist in application.properties)
# SERVER_PORT=8085
# JWT_EXPIRATION=86400000
# ALLOWED_ORIGINS=http://localhost:5173,https://your-deployed-frontend.example
